# Server
PORT=3000

# Mongo
MONGO_URL=mongodb://127.0.0.1:27017/wa_mod

# Green-API (replace with your instance values)
GREEN_URL=https://api.green-api.com
GREEN_ID=YOUR_INSTANCE_ID
GREEN_TOKEN=YOUR_INSTANCE_TOKEN

# Community groups (comma-separated WhatsApp group IDs like 12345@g.us)
COMMUNITY_GROUP_IDS=1234567890-1111@g.us,1234567890-2222@g.us

# Google Apps Script Web App URL to log spammers to a Google Sheet
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
