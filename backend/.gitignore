# --- dependencies ---
node_modules/

# --- builds & caches ---
dist/
build/
coverage/
.nyc_output/
.cache/
.tmp/
*.tsbuildinfo

# --- logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- environment files (keep only the template) ---
.env
.env.*
!.env.example

# --- OS & editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
# (if you want to keep workspace-relevant VS Code files, remove .vscode/ above
# and unignore specific ones like:)
# !.vscode/extensions.json
# !.vscode/settings.json

# --- local data / dumps (optional, if you ever export/import Mongo locally) ---
dump/
data/

# --- temp archives & misc ---
*.tar.gz
*.zip
