# template for the repo- a template checked into git (placeholders, safe to share).
# -----------------------------
# Server
# -----------------------------
# Port for the Express API
PORT=3000

# -----------------------------
# MongoDB
# -----------------------------
# Example local Mongo URL. Replace with your own when running.
MONGO_URL=mongodb://127.0.0.1:27017/wa_mod

# -----------------------------
# Green-API (WhatsApp bridge)
# -----------------------------
# Base URL for Green-API
GREEN_URL=https://api.green-api.com
# Your Green-API instance id (e.g., 110110)
GREEN_ID=YOUR_INSTANCE_ID
# Your Green-API token
GREEN_TOKEN=YOUR_INSTANCE_TOKEN

# -----------------------------
# WhatsApp Groups (comma-separated)
# Example format: 1234567890-1111@g.us
# -----------------------------
COMMUNITY_GROUP_IDS=1234567890-1111@g.us,1234567890-2222@g.us

# -----------------------------
# Optional: Google Apps Script Webhook to log moderation events
# Leave empty if not using
# -----------------------------
SHEETS_WEBHOOK_URL=

# -----------------------------
# MOCK mode
# Set to 1 to disable real Green-API calls (logs only).
# Keep commented in the example; developers can enable in .env.local
# -----------------------------
# MOCK=1
